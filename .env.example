# Django
# Generate a strong secret (never commit a real one):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT signing key. Falls back to DJANGO_SECRET_KEY when unset; set a separate
# secret in production so rotating one does not rotate the other.
# Generate it the same way as DJANGO_SECRET_KEY, then uncomment:
# JWT_SECRET_KEY=

# Rate limits for the endpoints an anonymous caller can reach. Format is
# "<count>/<period>" with period s, m, h or d. Raise these for end-to-end runs.
THROTTLE_LOGIN_RATE=10/5m
THROTTLE_REGISTER_RATE=30/h

# Number of proxy hops in front of the app; 1 behind the production host, so the
# throttles key on the real client address.
NINJA_NUM_PROXIES=1

# PostgreSQL
POSTGRES_DB=nordvik
POSTGRES_USER=nordvik
POSTGRES_PASSWORD=nordvik
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1