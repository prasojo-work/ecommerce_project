  "info": {
    "description": "Storefront API for LYSHEIM.",
    "title": "LYSHEIM API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/addresses": {
      "get": {
        "description": "`US-2.5`.",
        "operationId": "accounts_addresses_api_list_addresses",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AddressSchema"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "AccessTokenAuth": []
          }
        ],
        "summary": "List addresses",
        "tags": [
          "accounts"
        ]
      },
      "post": {
        "description": "The first address becomes the default whether or not the client asked for it.\n\nAn account whose only address is not the default is a state checkout would have to special-case\nfor no benefit, so it is not reachable.",
        "operationId": "accounts_addresses_api_create_address",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressCreateSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressSchema"
                }
              }
            },
            "description": "Created"
          }
        },
        "security": [
          {
            "AccessTokenAuth": []
          }
        ],
        "summary": "Add an address",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/addresses/{address_id}": {
      "delete": {
        "description": "`US-2.5`.\n\nDeleting the default promotes the oldest survivor, so the account keeps exactly one default for\nas long as it has any address at all \u2014 the same invariant the other endpoints hold.",
