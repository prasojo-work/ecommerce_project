        },
        "security": [
          {
            "AccessTokenAuth": []
          }
        ],
        "summary": "Remove an address",
        "tags": [
          "accounts"
        ]
      },
      "patch": {
        "description": "`US-2.5`. Only the fields present in the body are touched.",
        "operationId": "accounts_addresses_api_update_address",
