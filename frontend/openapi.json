    "/api/v1/products": {
      "get": {
        "description": "Filtered, sorted, paginated products.\n\nAn unknown `category` filters to nothing rather than erroring, so the storefront can render its\nexplicit no-results state (`US-1.3`).",
        "operationId": "catalog_api_list_products",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "description": "Minimum price, in cents.",
            "in": "query",
            "name": "min_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum price, in cents.",
              "title": "Min Price"
            }
          },
          {
            "description": "Maximum price, in cents.",
            "in": "query",
            "name": "max_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum price, in cents.",
              "title": "Max Price"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "description": "`sort` values from `API.md` section 4. The `-` prefix means descending.\n\nMembers are upper case because `Enum` already defines `name` and `value`; a member named\n`name` would shadow one of them.",
                  "enum": [
                    "name",
                    "price",
                    "-price",
                    "newest"
                  ],
                  "title": "SortOption",
                  "type": "string"
                }
              ],
              "default": "name"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageSchema"
                }
              }
            },
            "description": "OK"
          }
        },
