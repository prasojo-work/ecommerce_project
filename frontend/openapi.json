{
  "components": {
    "schemas": {
      "AddressCreateSchema": {
        "description": "A new address. `label`, `line2`, `region` and `phone` are optional, as the model has them.\n\nThe lengths are the model's, repeated here so an over-long field is a `400` naming the field\nrather than a database error on PostgreSQL and a silent pass on SQLite \u2014 the difference `M1.2`\nfound the hard way. The required fields also carry a floor of one character: the model declares\nthem non-blank, and nothing in the database refuses `recipient = \"\"`, so without this an address\ncheckout could not use would be stored happily.",
        "properties": {
          "city": {
            "maxLength": 120,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "country": {
            "maxLength": 2,
            "minLength": 2,
            "title": "Country",
            "type": "string"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          },
          "label": {
            "default": "",
            "maxLength": 60,
            "title": "Label",
            "type": "string"
          },
          "line1": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "default": "",
            "maxLength": 120,
            "title": "Line2",
            "type": "string"
          },
          "phone": {
            "default": "",
            "maxLength": 32,
            "title": "Phone",
            "type": "string"
          },
          "postal_code": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Postal Code",
            "type": "string"
          },
          "recipient": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Recipient",
            "type": "string"
          },
          "region": {
            "default": "",
            "maxLength": 120,
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "recipient",
          "line1",
          "city",
          "postal_code",
          "country"
        ],
        "title": "AddressCreateSchema",
        "type": "object"
      },
