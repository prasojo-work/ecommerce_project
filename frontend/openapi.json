      "ProductFilters": {
        "description": "Query parameters for `GET /products` (`API.md` section 4).\n\n`min_price` and `max_price` are integer cents, matching the payload convention in `API.md`\nsection 1, so a client never converts to a decimal in order to filter.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "max_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum price, in cents.",
            "title": "Max Price"
          },
          "min_price": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Minimum price, in cents.",
            "title": "Min Price"
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 24,
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "q": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Q"
          },
          "sort": {
            "allOf": [
              {
                "description": "`sort` values from `API.md` section 4. The `-` prefix means descending.\n\nMembers are upper case because `Enum` already defines `name` and `value`; a member named\n`name` would shadow one of them.",
                "enum": [
                  "name",
                  "price",
                  "-price",
                  "newest"
                ],
                "title": "SortOption",
                "type": "string"
              }
            ],
            "default": "name"
          }
        },
        "title": "ProductFilters",
        "type": "object"
      },
