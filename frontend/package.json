{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "codegen": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "pnpm codegen && next dev",
    "build": "pnpm codegen && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm codegen && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:routes": "playwright test",
    "axe:audit": "playwright test e2e/a11y.spec.ts",
    "perf:audit": "playwright test e2e/perf.spec.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
