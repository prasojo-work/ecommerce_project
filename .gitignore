# Python / Django
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3
/media/
# Collected static files. Not anchored to the repository root: `STATIC_ROOT` is
# `backend/staticfiles/`, so a root-anchored rule would match nothing and `git add -A` would commit
# every collected stylesheet (521 files, at the time this was found).
staticfiles/
.ruff_cache/
.mypy_cache/
.basedpyright/
.pytest_cache/
htmlcov/
.coverage

# Node / Next.js
node_modules/
.next/
out/
dist/
coverage/
.pnpm-store/
*.tsbuildinfo

# Playwright — the browsers are installed from the registry, never vendored
test-results/
playwright-report/
blob-report/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
*.log
.idea/
.vscode/
