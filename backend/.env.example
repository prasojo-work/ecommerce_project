# LYSHEIM backend — environment variables.
# Copy to `.env` for local development. Never commit a real `.env`.

# dev | prod — selects config/settings/<name>.py. A DJANGO_SETTINGS_MODULE already present
# in the environment wins, so this only matters for a plain `uv run` / container start.
DJANGO_ENV=dev

# A long, random value. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me-in-local-dev

DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# Comma-separated. In production this is the Render hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection (Supabase in the cloud). Leave empty to use SQLite locally.
DATABASE_URL=postgres://lysheim:lysheim@localhost:5432/lysheim

# Comma-separated browser origins allowed to call the API (the Vercel URL in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth tokens (ADR-0009). Leave JWT_SECRET_KEY empty to reuse DJANGO_SECRET_KEY locally.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# mock for v1 (see ADR-0010).
PAYMENT_PROVIDER=mock
