# LYSHEIM backend — environment variables.
# Copy to `.env` for local development. Never commit a real `.env`.

# dev | prod — selects config/settings/<name>.py. A DJANGO_SETTINGS_MODULE already present
# in the environment wins, so this only matters for a plain `uv run` / container start.
DJANGO_ENV=dev

# A long, random value. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me-in-local-dev

DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# Comma-separated. In production this is the Render hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection (Supabase in the cloud). Leave empty to use SQLite locally.
DATABASE_URL=postgres://lysheim:lysheim@localhost:5432/lysheim

# Comma-separated browser origins allowed to call the API (the Vercel URL in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth tokens (ADR-0009). Leave JWT_SECRET_KEY empty to reuse DJANGO_SECRET_KEY locally.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# Rate limiting (M2.3). How many proxies sit in front of the app decides whose IP a throttle counts:
# 0 locally, 2 on Render — Cloudflare's edge plus Render's balancer, see the note in base.py. Rates
# live in settings as NINJA_DEFAULT_THROTTLE_RATES.
NINJA_NUM_PROXIES=0

# The throttle store. Per-process memory suits a single uvicorn worker; use a shared backend before
# running more than one, or each worker will allow the full rate on its own.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=lysheim-throttle

# mock for v1 (see ADR-0010).
PAYMENT_PROVIDER=mock

# Background tasks (ADR-0006). Django 6 ships only `immediate`, which runs the task in the calling
# process — right for a single web service and for tests. A worker-backed backend is a value here
# plus a worker process, with no code change.
DJANGO_TASK_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# Email, in the mock-first spirit of ADR-0010: `locmem` sends nothing and collects messages in
# `django.core.mail.outbox`. A real transport is a value here, not a code change. Django 6.1
# configures mailers this way rather than through the deprecated EMAIL_BACKEND setting.
DJANGO_MAILER_BACKEND=django.core.mail.backends.locmem.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=LYSHEIM <no-reply@lysheim.example>
